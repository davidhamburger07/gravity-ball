# Copy this file to .env.local and paste your real values in.
# .env.local is gitignored; this example file is safe to commit.
#
# Upstash console -> your database -> "REST API" section -> click the ".env" button -> Copy.
UPSTASH_REDIS_REST_URL=https://your-database-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=paste_the_long_token_here

# Lets you add levels to the Featured list. Invent any long random string and set the SAME
# value in the Vercel dashboard. Anyone holding it can feature or hide levels, so treat it
# like a password.
GB_ADMIN_KEY=change_me_to_something_long_and_random
